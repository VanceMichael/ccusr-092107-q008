{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "城市政策版本",
  "type": "object",
  "required": ["cities"],
  "properties": {
    "cities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["city", "versions"],
        "properties": {
          "city": { "type": "string", "minLength": 1 },
          "versions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "version",
                "effective_from",
                "effective_to",
                "scenarios",
                "restriction_years"
              ],
              "properties": {
                "version": { "type": "integer", "minimum": 1 },
                "effective_from": { "type": "string", "format": "date" },
                "effective_to": { "type": ["string", "null"], "format": "date" },
                "scenarios": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "object",
                    "required": [
                      "annual_limit",
                      "requires_vouchers",
                      "requires_family_auth"
                    ],
                    "properties": {
                      "annual_limit": { "type": "integer", "minimum": 0 },
                      "requires_vouchers": { "type": "boolean" },
                      "requires_family_auth": { "type": "boolean" }
                    },
                    "additionalProperties": false
                  }
                },
                "restriction_years": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": { "type": "integer", "minimum": 1 }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
